		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a59" TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts117">
				<ANNOTATION_VALUE>I was telling her how two and three review copies go to all these places and people haven't gotten time.</ANNOTATION_VALUE>
