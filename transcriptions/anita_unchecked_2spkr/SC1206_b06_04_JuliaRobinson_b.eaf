		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a45" TIME_SLOT_REF1="ts88" TIME_SLOT_REF2="ts89">
				<ANNOTATION_VALUE>And this woman came up to her and said, I just loved your book.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
