			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a41" TIME_SLOT_REF1="ts80" TIME_SLOT_REF2="ts81">
				<ANNOTATION_VALUE>She says she sent a book at the Minneapolis Star Tribune, let's say.</ANNOTATION_VALUE>
