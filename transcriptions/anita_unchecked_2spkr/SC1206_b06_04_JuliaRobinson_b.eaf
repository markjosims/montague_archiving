		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a101" TIME_SLOT_REF1="ts200" TIME_SLOT_REF2="ts201">
				<ANNOTATION_VALUE>Oh, it's a beautiful letter.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
