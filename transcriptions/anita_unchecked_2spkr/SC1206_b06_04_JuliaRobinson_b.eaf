		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts206" TIME_SLOT_REF2="ts207">
				<ANNOTATION_VALUE>In fact, I read it to Edie just because I called it.</ANNOTATION_VALUE>
