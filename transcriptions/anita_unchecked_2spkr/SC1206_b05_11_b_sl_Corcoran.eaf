		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a94" TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts187">
				<ANNOTATION_VALUE>I've just been so excited by this nondiscussion of Catholicism that I just don't notice my pee going down.</ANNOTATION_VALUE>
