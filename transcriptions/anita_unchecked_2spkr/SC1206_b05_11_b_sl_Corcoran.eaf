			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a73" TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts145">
				<ANNOTATION_VALUE>My sister married a Jewish man who at the time was my best friend.</ANNOTATION_VALUE>
