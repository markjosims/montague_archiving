		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a112" TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts223">
				<ANNOTATION_VALUE>Yeah, he thought it was a mystery that he had no idea how this could be.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
