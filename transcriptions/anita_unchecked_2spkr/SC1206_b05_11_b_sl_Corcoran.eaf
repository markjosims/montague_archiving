			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a111" TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts221">
				<ANNOTATION_VALUE>So that he talked about antiSemitism to you?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
