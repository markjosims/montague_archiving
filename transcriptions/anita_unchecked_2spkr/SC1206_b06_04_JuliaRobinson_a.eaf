		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a53" TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts105">
				<ANNOTATION_VALUE>Kathleen told me that Julia had said to her once that what she really liked was a job she shared with Raphael.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
				<ANNOTATION_VALUE>Now she never said anything like this to me, but it has the ring of truth.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a55" TIME_SLOT_REF1="ts108" TIME_SLOT_REF2="ts109">
				<ANNOTATION_VALUE>Sure, sure.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a56" TIME_SLOT_REF1="ts110" TIME_SLOT_REF2="ts111">
				<ANNOTATION_VALUE>Because Raphael wanted to retire early and do more mathematics, and Julia, after her operation, was getting to the point where she could do more, and it was the kind of at that time, fairly creative idea you would say.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
