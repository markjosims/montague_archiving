		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a52" TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts103">
				<ANNOTATION_VALUE>And there was this discussion about whether Julia was denied tenure at Berkeley and so forth.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
