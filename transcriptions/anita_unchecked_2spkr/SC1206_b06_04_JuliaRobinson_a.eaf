			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a46" TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts91">
				<ANNOTATION_VALUE>There's nothing of that sort, I don't think that I can because I'm hearing a lot of stuff from other people too.</ANNOTATION_VALUE>
