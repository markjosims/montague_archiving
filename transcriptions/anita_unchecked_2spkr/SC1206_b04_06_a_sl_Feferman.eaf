				<ANNOTATION_VALUE>That was the second year already you were going through the seminar?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a129" TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts257">
				<ANNOTATION_VALUE>Yeah which was a little early?</ANNOTATION_VALUE>
