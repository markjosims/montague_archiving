			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a130" TIME_SLOT_REF1="ts258" TIME_SLOT_REF2="ts259">
				<ANNOTATION_VALUE>Yeah I think it was the second year maybe I'm pretty sure it was the second okay How soon did you ask him if you could work with him I don't remember I want to get some Yeah so the seminar you started to say about So I worked hard to do the initial this first presentation in which I had to work out for myself various proofs.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
