	<TIER TIER_ID="default" LINGUISTIC_TYPE_REF="default-lt">
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a54" TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts107">
				<ANNOTATION_VALUE>Okay.</ANNOTATION_VALUE>
