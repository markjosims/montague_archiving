			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a154" TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts307">
				<ANNOTATION_VALUE>He might have Well what about Cleaney for example or any of those people?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
