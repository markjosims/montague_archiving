		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a135" TIME_SLOT_REF1="ts268" TIME_SLOT_REF2="ts269">
				<ANNOTATION_VALUE>Right I mean it may have been the case with other people.</ANNOTATION_VALUE>
