			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
				<ANNOTATION_VALUE>Well, I mean, you don't own anybody, but you can mine, but there's nothing What I mean is he has no right to Yeah.</ANNOTATION_VALUE>
