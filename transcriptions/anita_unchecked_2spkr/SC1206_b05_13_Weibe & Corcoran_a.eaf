		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
				<ANNOTATION_VALUE>He didn't so much like the idea that I was doing it, but on the other hand he wasn't doing it.</ANNOTATION_VALUE>
