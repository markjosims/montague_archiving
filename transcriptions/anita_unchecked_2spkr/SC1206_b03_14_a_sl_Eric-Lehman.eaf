		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts4" TIME_SLOT_REF2="ts5">
				<ANNOTATION_VALUE>This morning I'm going to interview Eric Lehman about his days with Tarski and Niman.</ANNOTATION_VALUE>
