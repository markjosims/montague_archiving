			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts48" TIME_SLOT_REF2="ts49">
				<ANNOTATION_VALUE>Have you read a Truman's book?</ANNOTATION_VALUE>
