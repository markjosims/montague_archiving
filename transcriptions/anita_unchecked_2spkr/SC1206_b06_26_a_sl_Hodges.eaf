		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a57" TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts113">
				<ANNOTATION_VALUE>Is that the way you write?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a63" TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts125">
				<ANNOTATION_VALUE>The philosophers decided that either they should hire a boat in the middle of the tent or they should take this in indication that he really didn't want to return to the part anymore and they read it the second way and if that wasn't his intention then tough is So it would have to be a place where nobody had smoked for twenty four hours so all it had to be is some room that was considered a nonsmoking room There is such a thing in Britain.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
