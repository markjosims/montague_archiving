			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts7">
				<ANNOTATION_VALUE>I'm talking to Wilfred Hodges on july twenty eighth, nineteen ninety four at Clermont Film about Tarski.</ANNOTATION_VALUE>
