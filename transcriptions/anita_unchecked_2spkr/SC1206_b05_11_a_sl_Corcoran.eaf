		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a83" TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts165">
				<ANNOTATION_VALUE>Well, I'm surprised he didn't pick some lovely young woman to sit on one side, at least.</ANNOTATION_VALUE>
