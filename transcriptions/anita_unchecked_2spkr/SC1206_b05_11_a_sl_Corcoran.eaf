			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a207" TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts413">
				<ANNOTATION_VALUE>At any rate, let me finish this Go ahead.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a208" TIME_SLOT_REF1="ts414" TIME_SLOT_REF2="ts415">
				<ANNOTATION_VALUE>We are I'm reading this to him and he had already put the French aside he was sure that the whole translation was fine he was now fine tuning the English and his eyes would droop and his head would droop and I would stop reading and then he would perk up and then when his head was down like this eyes closed and I stopped reading for maybe ten seconds and he said Please continue.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a209" TIME_SLOT_REF1="ts416" TIME_SLOT_REF2="ts417">
				<ANNOTATION_VALUE>So he was still he still had his mind going Everything else was finished and he actually made some clever remarks on what he was listening to when he was his head That is that is wonderful.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a210" TIME_SLOT_REF1="ts418" TIME_SLOT_REF2="ts419">
				<ANNOTATION_VALUE>He was a very exciting and charming person in my presence for the most part it was just the two of us and he would be very talkative but most of the time we were together we were working we weren't and sometimes we would relax and smoke cigars.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a211" TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts421">
				<ANNOTATION_VALUE>You were smoking I was smoking cigars at the time.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a212" TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts423">
				<ANNOTATION_VALUE>His little ones?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a213" TIME_SLOT_REF1="ts424" TIME_SLOT_REF2="ts425">
				<ANNOTATION_VALUE>His little Robert Burns cigars which I enjoyed very much.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a214" TIME_SLOT_REF1="ts426" TIME_SLOT_REF2="ts427">
				<ANNOTATION_VALUE>Did you smoke cigars otherwise or you just did it with him?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
