		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a166" TIME_SLOT_REF1="ts330" TIME_SLOT_REF2="ts331">
				<ANNOTATION_VALUE>Okay, well I'd love to see that letter of Did you agree?</ANNOTATION_VALUE>
