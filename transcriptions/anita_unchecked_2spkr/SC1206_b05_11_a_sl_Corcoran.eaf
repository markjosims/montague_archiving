			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a201" TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts401">
				<ANNOTATION_VALUE>He took before he gave his address for his honorary degree in Marseille, he took something Cola Maupin, which is like ColaSier, which Gervant mentioned.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
