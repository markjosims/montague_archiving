		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a78" TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts155">
				<ANNOTATION_VALUE>And Tarski nobody sat down until Tarski decided where he was going to sit.</ANNOTATION_VALUE>
