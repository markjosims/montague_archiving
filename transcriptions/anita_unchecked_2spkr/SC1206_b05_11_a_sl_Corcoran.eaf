			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a119" TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts237">
				<ANNOTATION_VALUE>Scott came up to me and said that he had gone to the library and got her dissertation out and read it and my results were not in there.</ANNOTATION_VALUE>
