			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a198" TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts395">
				<ANNOTATION_VALUE>But you never I mean No Jivant said in Java in the article on the Mathematical Intelligence or exactly what it was there.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
