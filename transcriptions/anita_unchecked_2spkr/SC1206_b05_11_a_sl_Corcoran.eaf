		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a203" TIME_SLOT_REF1="ts404" TIME_SLOT_REF2="ts405">
				<ANNOTATION_VALUE>And but earlier in his life he took benzedrine when he was told that to CC Chang.</ANNOTATION_VALUE>
