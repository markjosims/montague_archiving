		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a169" TIME_SLOT_REF1="ts336" TIME_SLOT_REF2="ts337">
				<ANNOTATION_VALUE>And so he didn't see the results of that either, obviously.</ANNOTATION_VALUE>
