		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a162" TIME_SLOT_REF1="ts322" TIME_SLOT_REF2="ts323">
				<ANNOTATION_VALUE>Well this was he must have sent me this letter in early eighty three.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
