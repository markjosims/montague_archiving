		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a164" TIME_SLOT_REF1="ts326" TIME_SLOT_REF2="ts327">
				<ANNOTATION_VALUE>I had intended to send you Right So he was already pretty he was already sick by then huh?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
