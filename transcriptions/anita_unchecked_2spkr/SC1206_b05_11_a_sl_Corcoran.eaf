		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a81" TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts161">
				<ANNOTATION_VALUE>Where people should sit?</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
