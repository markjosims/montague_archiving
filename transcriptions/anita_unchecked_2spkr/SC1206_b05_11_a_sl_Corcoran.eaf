			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a218" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts435">
				<ANNOTATION_VALUE>Yeah, I think he did.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
