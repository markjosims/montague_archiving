		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a204" TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts407">
				<ANNOTATION_VALUE>So he was high all the time I mean you know how high he looked?</ANNOTATION_VALUE>
