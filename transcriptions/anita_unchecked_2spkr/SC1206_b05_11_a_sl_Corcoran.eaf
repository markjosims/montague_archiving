			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a77" TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts153">
				<ANNOTATION_VALUE>And those were the salad days of logic when there were people were dying to get into your logic classes.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
