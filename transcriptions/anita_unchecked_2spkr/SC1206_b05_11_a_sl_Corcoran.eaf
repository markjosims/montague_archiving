			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a202" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts403">
				<ANNOTATION_VALUE>So he took various cola derivatives which are cocaine based.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
