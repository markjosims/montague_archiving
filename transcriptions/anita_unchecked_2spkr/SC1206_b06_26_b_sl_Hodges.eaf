		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a49" TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts97">
				<ANNOTATION_VALUE>That wasn't tasking No, he wouldn't do that.</ANNOTATION_VALUE>
