		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a108" TIME_SLOT_REF1="ts214" TIME_SLOT_REF2="ts215">
				<ANNOTATION_VALUE>Let's see I guess I view Tarski's theory of truth itself as something of another idea as not in any way an explication of the ordinary notion of truth.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
