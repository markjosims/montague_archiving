		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts59">
				<ANNOTATION_VALUE>And then the next term, I'm trying to think I could check my notes because I took the second and the second semester, I was drafted in the middle of the term.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a31" TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts61">
				<ANNOTATION_VALUE>I don't think I took the second term at all.</ANNOTATION_VALUE>
