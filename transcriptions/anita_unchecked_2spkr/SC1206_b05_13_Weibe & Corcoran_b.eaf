			</ANNOTATION>
		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a351" TIME_SLOT_REF1="ts700" TIME_SLOT_REF2="ts701">
				<ANNOTATION_VALUE>I mean, it's in libraries, but you can Black Oak would be a place to get it or you can get it if you wanted to own a copy or they may not have it, but that's certainly on there they had it at one time.</ANNOTATION_VALUE>
				</ALIGNABLE_ANNOTATION>
