		<ANNOTATION>
			<ALIGNABLE_ANNOTATION ANNOTATION_ID="a348" TIME_SLOT_REF1="ts694" TIME_SLOT_REF2="ts695">
				<ANNOTATION_VALUE>It was a fascinating project.</ANNOTATION_VALUE>
